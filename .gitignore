# Generated by Cargo
debug
target

# Backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc store debugging information here
*.pdb

# Generated by cargo mutants
**/mutants.out*/

# rustc dumps stack traces here on an internal compiler error
rustc-ice-*.txt

# Mesh output from manual runs (fixtures in test-fixtures/ are tracked)
/mesh-output/
/output/
/*.vtu
/*.vtm
/*.msh

# Python helpers for fixture preparation and ParaView checks
__pycache__/

# Local environment and system files
.env
.env.*
.DS_Store
