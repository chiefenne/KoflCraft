Merge "charts.msh";
CreateTopology;
CreateGeometry;
shell = newsl;
Surface Loop(shell) = Surface{:};
Volume(1) = {shell};
Mesh.MinimumCurveNodes = 2;
Mesh.MeshSizeMin = 0.65;
Field[1] = Distance;
Field[1].CurvesList = {1:480};
Field[2] = Threshold;
Field[2].InField = 1;
Field[2].SizeMin = 0.85;
Field[2].SizeMax = 6;
Field[2].DistMin = 0.5;
Field[2].DistMax = 13;
Background Field = 2;
Mesh.MeshSizeMax = 6.25;
Mesh.MeshSizeFromCurvature = 0;
Mesh.MeshSizeExtendFromBoundary = 0;
Mesh.Algorithm = 6;
Mesh.Algorithm3D = 1;
Mesh.Optimize = 1;
Mesh.MshFileVersion = 2.2;
Physical Volume("fluid",4)={1};
Mesh.OptimizeNetgen = 1;
